# Server-side key (preferred — used by Vite dev proxy and Vercel /api/ai).
# VITE_AI_API_KEY is still accepted as a fallback for backwards compatibility.
AI_API_KEY=sk-or-v1-your-openrouter-api-key
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
# Use a real OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-haiku-4.5
VITE_AI_MODEL=openai/gpt-4o-mini
